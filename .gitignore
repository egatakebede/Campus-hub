**/.env
**/.env.*
!**/.env.example

# Logs
*.log
server.log

# OS
.DS_Store
Thumbs.db

# IDE / editor
.vscode/
.idea/
*.swp

# Build output
**/dist/
**/build/

# Coverage
**/coverage/

# Tooling
.kilo/
.trunk/

# Local temp
temp/
tmp/
