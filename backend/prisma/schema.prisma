generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  telegramId              BigInt           @id
  name                    String
  username                String?          @unique
  phone                   String?
  department              String
  yearOfStudy             Int
  bio                     String?
  profilePictureUrl       String?
  status                  UserStatus       @default(PENDING)
  isModerator             Boolean          @default(false)
  showPhone               Boolean          @default(true)
  studentIdNumber         String?
  idPhotoPath             String?
  verificationSubmittedAt DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  bookmarks               Bookmark[]
  listings                Listing[]
  reports                 Report[]
  ratingsGiven            Rating[]
  savedSearches           SavedSearch[]
  serviceProfiles         ServiceProfile[]
  adminActions            AdminAuditLog[]

  @@index([status])
  @@index([verificationSubmittedAt])
}

model Category {
  id              Int              @id @default(autoincrement())
  name            String
  type            CategoryType
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  listings        Listing[]
  serviceProfiles ServiceProfile[]

  @@unique([name, type])
  @@index([type])
}

model Listing {
  id                String        @id @default(uuid()) @db.Uuid
  sellerId          BigInt
  categoryId        Int
  title             String
  description       String
  price             Decimal       @db.Decimal(10, 2)
  imageUrls         String[]
  listingType       ListingType   @default(SELL)
  details           Json          @default("{}")
  campus            String        @default("")
  originalListingId String?       @db.Uuid
  status            ListingStatus @default(ACTIVE)
  expiresAt         DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  category          Category      @relation(fields: [categoryId], references: [id])
  seller            User          @relation(fields: [sellerId], references: [telegramId])

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([originalListingId])
  @@index([expiresAt])
  @@index([deletedAt])
}

model ServiceProfile {
  id              String    @id @default(uuid()) @db.Uuid
  providerId      BigInt
  categoryId      Int
  title           String
  description     String
  portfolioImages String[]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  category        Category  @relation(fields: [categoryId], references: [id])
  provider        User      @relation(fields: [providerId], references: [telegramId])

  @@index([providerId])
  @@index([categoryId])
  @@index([isActive])
  @@index([deletedAt])
}

model Bookmark {
  id         String     @id @default(uuid()) @db.Uuid
  userId     BigInt
  targetId   String     @db.Uuid
  targetType TargetType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [telegramId])

  @@unique([userId, targetId, targetType])
  @@index([userId])
}

model Report {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId BigInt
  targetId   String       @db.Uuid
  targetType TargetType
  reason     String
  details    String?
  resolutionNotes String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  reporter   User         @relation(fields: [reporterId], references: [telegramId])

  @@unique([reporterId, targetId, targetType])
  @@index([status])
}

model AdminAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    BigInt
  action     String   @db.VarChar(80)
  targetType String   @db.VarChar(32)
  targetId   String?  @db.VarChar(128)
  details    String?  @db.VarChar(500)
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [telegramId])

  @@index([createdAt])
  @@index([actorId])
}

model Rating {
  id         String           @id @default(uuid()) @db.Uuid
  reviewerId BigInt
  targetType RatingTargetType
  targetId   String
  score      Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  reviewer   User             @relation(fields: [reviewerId], references: [telegramId], onDelete: Cascade)

  @@unique([reviewerId, targetType, targetId])
  @@index([targetType, targetId])
}

model SavedSearch {
  id              String   @id @default(uuid()) @db.Uuid
  userId          BigInt
  query           String   @db.VarChar(80)
  normalizedQuery String   @db.VarChar(80)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [telegramId], onDelete: Cascade)

  @@unique([userId, normalizedQuery])
  @@index([userId])
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum ListingStatus {
  PENDING
  ACTIVE
  PAUSED
  SOLD
  RENTED
  EXPIRED
}

enum ListingType {
  SELL
  RENT
  SERVICE
}

enum CategoryType {
  MARKETPLACE
  SERVICE
}

enum TargetType {
  LISTING
  SERVICE
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
}

enum RatingTargetType {
  SELLER
  LISTING
  APP
}
